# Copy this file to .env and add your key.
# The application also works without an API key using deterministic fallback logic.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Local persistence
AGENT_DB_PATH=data/agent.db

# Runtime guardrails
MAX_TOOL_CALLS=12
CONTEXT_TOKEN_BUDGET=6000
