# Copy this file to .env and add your Gemini API key.
# The application also works without an API key using deterministic fallback logic.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Local persistence
AGENT_DB_PATH=data/agent.db

# Runtime guardrails
MAX_TOOL_CALLS=12
CONTEXT_TOKEN_BUDGET=6000
