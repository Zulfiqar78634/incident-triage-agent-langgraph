# Incident Triage & Safe Remediation Agent
# Copy this file to .env and replace values only when needed.

# Optional: enables Gemini-backed diagnosis enrichment.
# Without this value, the agent uses deterministic diagnosis.
GEMINI_API_KEY=

# Optional: override the Gemini model if needed.
GEMINI_MODEL=gemini-2.0-flash

# Local runtime settings.
APP_ENV=local
LOG_LEVEL=INFO
